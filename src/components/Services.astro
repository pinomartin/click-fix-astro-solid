---
import { useTranslations, type Lang } from "../i18n/ui";
import Parallax from "./islands/Parallax";
import ServiceCard from "./ServiceCard.astro";
import cloudSvg from "../assets/img/common/cloud.svg";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    title: t("services.web.title"),
    desc: t("services.web.desc"),
    longDesc: t("services.web.longDesc"),
    icon: "web",
  },
  {
    title: t("services.seo.title"),
    desc: t("services.seo.desc"),
    longDesc: t("services.seo.longDesc"),
    icon: "search",
  },
  {
    title: t("services.app.title"),
    desc: t("services.app.desc"),
    longDesc: t("services.app.longDesc"),
    icon: "mobile",
  },
];
---

<section id="services" class="services section">
  <div class="container">
    <h2 class="section-title text-center">{t("services.title")}</h2>

    <div class="grid-wrapper">
      <div class="parallax-bg">
        <Parallax
          client:only="solid-js"
          src={cloudSvg.src}
          alt="Decorative background"
          scale={1.2}
          orientation="up"
          className="parallax-img"
        />
      </div>

      <div class="services-grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              desc={service.desc}
              longDesc={service.longDesc}
              icon={service.icon}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .grid-wrapper {
    position: relative;
    display: grid;
    grid-template-areas: "stack";
    margin-top: var(--space-xl);
    padding: var(--space-xl) 0;
  }

  .parallax-bg {
    grid-area: stack;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    min-height: 100%;
    max-height: 100vh;
    /* height: 120%; */
    z-index: 0;
    pointer-events: none;
    opacity: 0.1;
    overflow: hidden;
  }

  :global(.parallax-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .parallax-bg {
      position: sticky;
      top: 20vh;
      height: 60vh;
      width: 100%;
      left: 0;
      transform: none;
      /* Ensure it stays within the grid area */
      grid-area: stack;
      align-self: start;
    }

    :global(.parallax-img) {
      object-fit: contain !important;
    }
  }

  .services-grid {
    grid-area: stack;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-xl);
    justify-content: center;
    align-items: center;
  }
</style>
